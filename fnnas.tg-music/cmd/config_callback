#!/bin/bash

# Merge TRIM_DATA_SHARE_PATHS and TRIM_DATA_ACCESSIBLE_PATHS
DATA_SHARE_PATHS="${TRIM_DATA_SHARE_PATHS:-}:${TRIM_DATA_ACCESSIBLE_PATHS:-}"
MERGED=""
IFS=':'
for p in ${DATA_SHARE_PATHS}; do
    if [ -n "${p}" ]; then
        case ":${MERGED}:" in
            *":${p}:"*) ;;
            *) MERGED="${MERGED:+${MERGED}:}${p}" ;;
        esac
    fi
done
unset IFS

echo "${MERGED}" > "${TRIM_PKGVAR}/accessible_paths"

exit 0
