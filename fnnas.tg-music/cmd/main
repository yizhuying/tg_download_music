#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

APP_PORT="${wizard_app_port}"
if [ -z "${APP_PORT}" ]; then
    APP_PORT="45116"
fi

APP_PASSWORD="${wizard_app_password}"
if [ -n "${APP_PASSWORD}" ]; then
    export ADMIN_PASSWORD="${APP_PASSWORD}"
fi

# Export fnOS data paths for the Go process
if [ -n "${TRIM_DATA_ACCESSIBLE_PATHS:-}" ]; then
    export TRIM_DATA_ACCESSIBLE_PATHS
fi

SESSION_DIR="${TRIM_PKGVAR}/sessions"
CONFIG_FILE="${TRIM_PKGVAR}/config.json"
SOCKET_FILE="${TRIM_PKGVAR}/app.sock"
SERVER_BIN="${TRIM_APPDEST}/server/tg-music-server"

mkdir -p "${SESSION_DIR}"

# Write accessible paths for Go process to read dynamically
echo "${TRIM_DATA_ACCESSIBLE_PATHS:-}" > "${TRIM_PKGVAR}/accessible_paths"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

#log_msg "=== Starting TuneGram ==="
#log_msg "TRIM_PKGVAR='${TRIM_PKGVAR:-}'"
#log_msg "TRIM_APPDEST='${TRIM_APPDEST:-}'"
#log_msg "TRIM_DATA_ACCESSIBLE_PATHS='${TRIM_DATA_ACCESSIBLE_PATHS:-}'"
#log_msg "APP_PORT='${APP_PORT}'"
#log_msg "SERVER_BIN='${SERVER_BIN}'"
#log_msg "CONFIG_FILE='${CONFIG_FILE}'"
#log_msg "SESSION_DIR='${SESSION_DIR}'"
#log_msg "SOCKET_FILE='${SOCKET_FILE}'"

# Check binary exists
if [ ! -x "${SERVER_BIN}" ]; then
    log_msg "ERROR: binary not found or not executable: ${SERVER_BIN}"
    exit 1
fi

# write the command to start your program here
CMD="${SERVER_BIN} -port ${APP_PORT} -config ${CONFIG_FILE} -socket ${SOCKET_FILE} -session-dir ${SESSION_DIR}"

#log_msg "CMD=${CMD}"

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting process ..."
    bash -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"
    log_msg "pid=$!"
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi

    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
