#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PKG_ROOT="$(dirname "${SCRIPT_DIR}")"

# fnOS runtime dir is /var/apps/<name>, symlink target points to actual install dir
if [ -L "${PKG_ROOT}/target" ]; then
    APP_ROOT="$(readlink -f "${PKG_ROOT}/target")"
else
    APP_ROOT="${PKG_ROOT}"
fi

# Fallback log/pid paths if TRIM_PKGVAR is empty
if [ -n "${TRIM_PKGVAR:-}" ]; then
    LOG_FILE="${TRIM_PKGVAR}/info.log"
    PID_FILE="${TRIM_PKGVAR}/app.pid"
else
    LOG_FILE="${APP_ROOT}/var/info.log"
    PID_FILE="${APP_ROOT}/var/app.pid"
    mkdir -p "${APP_ROOT}/var"
fi
APP_PORT="${wizard_app_port}"
if [ -z "${APP_PORT}" ]; then
    APP_PORT="8080"
fi

# Debug
echo "TRIM_PKGVAR='${TRIM_PKGVAR:-}'" >> "${LOG_FILE}" 2>/dev/null || true
echo "APP_ROOT='${APP_ROOT}'" >> "${LOG_FILE}" 2>/dev/null || true
echo "APP_PORT='${APP_PORT}'" >> "${LOG_FILE}" 2>/dev/null || true
echo "TRIM_DATA_ACCESSIBLE_PATHS='${TRIM_DATA_ACCESSIBLE_PATHS:-}'" >> "${LOG_FILE}" 2>/dev/null || true

# Export fnOS data paths for the Go process
if [ -n "${TRIM_DATA_ACCESSIBLE_PATHS:-}" ]; then
    export TRIM_DATA_ACCESSIBLE_PATHS
fi

echo "应用端口: $APP_PORT"

# Construct paths relative to actual install directory
SERVER_BIN="${APP_ROOT}/server/telegram-music-server"
CONFIG_FILE="${APP_ROOT}/config.json"
SOCKET_FILE="${APP_ROOT}/app.sock"

# Data directory (writable by app user: /vol1/@appdata/<appname>)
APP_DATA="${PKG_ROOT}/var"
SESSION_DIR="${APP_DATA}/sessions"

# Ensure session directory exists
mkdir -p "${SESSION_DIR}"

# write the command to start your program here
CMD="${SERVER_BIN} -port ${APP_PORT} -config ${CONFIG_FILE} -socket ${SOCKET_FILE} -session-dir ${SESSION_DIR}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting process ..."
    bash -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> "${LOG_FILE}" 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi

    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
